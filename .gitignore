# ORBIT Dashboard — git ignore

# ── Generated data files (rebuilt by Refresh_ORBIT.ps1, contain employee PII) ──
orbit-data.js
orbit-auth.js

# ── Raw source data (contain employee names and performance metrics) ──
prod_raw.csv
qa_raw.csv
assoc_raw.csv
*.xlsx
*.xls

# ── Keys and credentials ──
orbit-keys.json
*.env
.env

# ── Local VCS artefacts (ORBIT's own backup/versioning system) ──
# These are operational snapshots, not source history.
_system/BACKUP/
_system/.versions/

# ── Database files ──
*.db
*.db-shm
*.db-wal

# ── OS noise ──
Thumbs.db
.DS_Store
desktop.ini

# ── Windows temp files ──
*.tmp
*.bak
~$*
